# ============================================================
# Credenciais da APLICAÇÃO Discord (uma vez no Developer Portal)
# NÃO são configuração de guild/canal — são segredos de infra.
# ============================================================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ============================================================
# API interna do bot (compartilhada web <-> bot, nunca no navegador)
# ============================================================
INTERNAL_API_SECRET=
INTERNAL_API_URL=http://bot:4000

# ============================================================
# Banco de dados (Postgres)
#   - Em serviços do compose: host "postgres"
#   - Rodando prisma localmente na VM/host: host "localhost"
# ============================================================
POSTGRES_USER=ponto
POSTGRES_PASSWORD=ponto
POSTGRES_DB=ponto
DATABASE_URL=postgresql://ponto:ponto@localhost:5432/ponto

# ============================================================
# NextAuth (login Discord no dashboard)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ============================================================
# Agendamentos / defaults
# ============================================================
BACKUP_CRON=0 * * * *
AUTO_CLOSE_SECONDS_DEFAULT=60
